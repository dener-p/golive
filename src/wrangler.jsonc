{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "golive",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ],
  "vars": {
    "MAX_VIEWERS": "8",
    "APP_VERSION": "0.5.0"
  },
  "routes": [
    { "pattern": "golive.puhl.dev", "custom_domain": true }
  ]
}
