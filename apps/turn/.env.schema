# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production)
NODE_ENV=development

# Cloudflare Calls TURN key used to mint short-lived credentials.
# @sensitive @type=string(minLength=16)
CLOUDFLARE_TURN_KEY_ID=

# @sensitive @type=string(minLength=16)
CLOUDFLARE_TURN_KEY_SECRET=

# Lifetime of each minted TURN credential in seconds (Cloudflare allows 60-36000).
# @public @type=string(minLength=1)
CLOUDFLARE_TURN_TOKEN_TTL=1800

# golive server webhook endpoint that receives pushed credentials:
# e.g. https://your-server.example.com/api/turn/webhook
# @optional @public @type=url
TURN_WEBHOOK_URL=

# Webhook API key created in the golive Settings page.
# Requests carry X-Turn-Key (this id), X-Turn-Timestamp (unix seconds) and
# X-Turn-Signature = HMAC-SHA256(TURN_WEBHOOK_KEY_SECRET, timestamp).
# @optional @sensitive @type=string
TURN_WEBHOOK_KEY=

# @optional @sensitive @type=string
TURN_WEBHOOK_KEY_SECRET=

# How often to push fresh credentials to TURN_WEBHOOK_URL (seconds).
# @public @type=string(minLength=1)
TURN_REFRESH_INTERVAL_SECONDS=300