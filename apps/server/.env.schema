DATABASE_URL=

# Master key used to encrypt user webhook API key secrets at rest (AES-256-GCM).
# Pass a 64-char hex string, or any string (hashed to 32 bytes). Requests to the
# TURN webhook carry X-Turn-Key (the key id), X-Turn-Timestamp (unix seconds) and
# X-Turn-Signature = HMAC-SHA256(secret, timestamp).
# @optional @sensitive @type=string(minLength=16)
TURN_API_KEY_ENC_KEY=
